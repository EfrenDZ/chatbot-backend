datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

enum BotMode {
  OPTIONS
  AI
  HYBRID
}

enum SessionStatus {
  BOT_HANDLING
  HANDED_OFF_TO_HUMAN
  RESOLVED
}

enum SenderType {
  USER
  BOT_OPTION
  BOT_AI
  AGENT
}

model Account {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chatwootAccountId   Int      @unique @map("chatwoot_account_id")
  chatwootApiUrl      String   @default("http://localhost:3000") @map("chatwoot_api_url")
  chatwootAccessToken String?  @map("chatwoot_access_token")
  name                String
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  botConfig           BotConfig?
  sessions            ConversationSession[]

  @@map("accounts")
}

model BotConfig {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId              String   @unique @db.Uuid @map("account_id")
  account                Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  botMode                BotMode  @default(HYBRID) @map("bot_mode")
  flowGraph              Json     @map("flow_graph")
  
  resetKeywords          String[] @default(["menu", "inicio", "reiniciar", "empezar"]) @map("reset_keywords")
  handoffKeywords        String[] @default(["humano", "agente", "asesor", "persona"]) @map("handoff_keywords")
  maxConsecutiveErrors   Int      @default(2) @map("max_consecutive_errors")
  sessionTimeoutHours    Int      @default(24) @map("session_timeout_hours")
  
  aiProvider             String   @default("openai") @map("ai_provider")
  aiModel                String   @default("gpt-4o-mini") @map("ai_model")
  aiPromptMode           String   @default("STRUCTURED") @map("ai_prompt_mode")
  systemPrompt           String?  @map("system_prompt")
  aiKnowledge            Json?    @map("ai_knowledge")
  maxAiMessages          Int      @default(8) @map("max_ai_messages")
  aiWrapUpMessages       Int      @default(2) @map("ai_wrap_up_messages")
  
  welcomeMessage         String?  @map("welcome_message")
  farewellMessage        String?  @map("farewell_message")
  fallbackMessage        String   @map("fallback_message")
  handoffMessage         String   @map("handoff_message")
  
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("bot_configs")
}

model ConversationSession {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId              String        @db.Uuid @map("account_id")
  account                Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  chatwootConversationId Int           @map("chatwoot_conversation_id")
  contactIdentifier      String?       @map("contact_identifier")
  
  status                 SessionStatus @default(BOT_HANDLING)
  currentNodeId          String?       @map("current_node_id")
  consecutiveErrors      Int           @default(0) @map("consecutive_errors")
  aiMessagesCount        Int           @default(0) @map("ai_messages_count")
  sessionMetadata        Json?         @default("{}") @map("session_metadata")
  
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at")

  messages               MessageLog[]

  @@unique([accountId, chatwootConversationId], name: "unique_account_conversation")
  @@map("conversation_sessions")
}

model MessageLog {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationSessionId   String              @db.Uuid @map("conversation_session_id")
  session                 ConversationSession @relation(fields: [conversationSessionId], references: [id], onDelete: Cascade)
  
  senderType              SenderType          @map("sender_type")
  content                 String
  tokensUsed              Int?                @default(0) @map("tokens_used")
  
  createdAt               DateTime            @default(now()) @map("created_at")

  @@map("message_logs")
}
